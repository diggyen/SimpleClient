+/* A work item decodes a batch of tiles rather than one: a tile is a few tens
+ * of microseconds of work, and the thread pool's allocation, locks and wakeups
+ * for each took a fifth of what decoding a full-screen video cost. */
+#define PROGRESSIVE_TILES_PER_WORK 8u
+
+static void CALLBACK progressive_process_tiles_batch_work_callback(PTP_CALLBACK_INSTANCE instance,
+                                                                   void* context, PTP_WORK work)
+{
+	PROGRESSIVE_TILE_PROCESS_WORK_PARAM* param = (PROGRESSIVE_TILE_PROCESS_WORK_PARAM*)context;
+
+	for (UINT32 i = 0; i < param->count; i++)
+		progressive_process_tiles_tile_work_callback(instance, &param[i], work);
+}
