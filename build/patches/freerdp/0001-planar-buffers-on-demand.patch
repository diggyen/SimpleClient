--- a/libfreerdp/core/codecs.c
+++ b/libfreerdp/core/codecs.c
@@ -186,7 +186,12 @@
 	{
 		if (codecs->planar)
 		{
-			rc &= freerdp_bitmap_planar_context_reset(codecs->planar, width, height);
+			/* The planar buffers take 18 bytes a pixel. Sized for the whole
+			 * desktop, in this context and again in the graphics pipeline's,
+			 * that was over half of what a session used: 180 MB at 3440x1440,
+			 * for bitmaps that are mostly 64x64. planar_decompress grows them
+			 * to the largest bitmap that comes instead. */
+			rc &= freerdp_bitmap_planar_context_reset(codecs->planar, 64, 64);
 		}
 	}
 
--- a/libfreerdp/codec/planar.c
