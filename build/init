#!/bin/sh
# SimpleClient init — minimal kiosk init, PID 1 inside the initramfs.
#
# Deliberately not "set -e": this is PID 1. If any single step fails the kernel
# panics on exit, so every step has to be allowed to fail and be reported
# instead. Progress goes to /dev/console, which grub.cfg points at the serial
# port so it never gets painted over the kiosk UI.

log() { echo "[simpleclient-init] $*" > /dev/console 2>/dev/null; }

# live_dev prints the FAT partition a kiosk running from a USB stick keeps its
# settings on: SC_EFI on a stick the ISO was written to as it is (dd, Rufus's
# DD mode), the one partition of a stick Rufus wrote in ISO mode, labelled
# with the ISO's volume ID cut to FAT's 11 characters. See bootenv.LiveDevice.
live_dev() { findfs LABEL=SC_EFI 2>/dev/null || findfs LABEL=SIMPLECLIEN 2>/dev/null; }

# The kernel starts /init with no PATH at all. Busybox finds its own applets
# regardless, but everything it starts inherits the empty PATH, and the kiosk
# could not find aplay/arecord in /usr/bin: sessions negotiated sound and then
# played nothing.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null

mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null

# The kernel loads modules on its own too — an HD Audio codec driver once the
# controller has probed the codec, a filesystem when a USB stick is mounted —
# by running the path in /proc/sys/kernel/modprobe, /sbin/modprobe by default.
# Busybox puts its applets in /bin, so without this every one of those requests
# failed silently: sound cards came up with no codec and made no sound.
echo /bin/modprobe > /proc/sys/kernel/modprobe 2>/dev/null

# Silence kernel log noise so it does not scribble over the UI.
echo 0 > /proc/sys/kernel/printk 2>/dev/null

# ── Splash ────────────────────────────────────────────────────────────────────
# The boot splash (ui.RunSplash): the picture GRUB showed while it loaded all
# this, now with its spinner turning, until the kiosk draws its first screen.
# Without it the screen stayed black for the whole boot. It is stopped while
# the GPU's driver takes the screen over — it draws into the firmware
# framebuffer, memory that then belongs to the GPU — and started again on the
# driver's. The console starts out blanked on some firmware, which would hide
# it. A boot that is not quiet — the debug entries of the boot menu — shows the
# kernel's log on the screen instead, which the splash would cover.
SPLASH=""
SPLASH_ON=0
grep -qw quiet /proc/cmdline 2>/dev/null && SPLASH_ON=1
splash_start() {
    [ "$SPLASH_ON" = 1 ] && [ -z "$SPLASH" ] && [ -e /dev/fb0 ] || return
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null
    /sbin/simpleclient -boot-graphics=splash 2>/dev/console &
    SPLASH=$!
}
splash_stop() {
    [ -n "$SPLASH" ] || return
    kill "$SPLASH" 2>/dev/null
    wait "$SPLASH" 2>/dev/null
    SPLASH=""
}
splash_start

# How this machine booted. Under Secure Boot the kernel locks itself down and
# loads signed modules only, which is worth knowing when a driver is missing.
if [ -d /sys/firmware/efi ]; then
    mount -t securityfs securityfs /sys/kernel/security 2>/dev/null
    sb=off
    dmesg | grep -q "Secure boot enabled" && sb=on
    lockdown=$(sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/kernel/security/lockdown 2>/dev/null)
    log "firmware: UEFI, Secure Boot $sb, lockdown ${lockdown:-?}"
else
    log "firmware: BIOS"
fi

# ── Kernel modules ────────────────────────────────────────────────────────────
# Debian's kernel builds nearly everything as a module. Two passes load them.
#
# First, a fixed list of what the kiosk cannot run without, so a machine whose
# hardware the second pass somehow misses still boots to a usable screen:
#   evdev      creates /dev/input/event*; without it the keyboard is invisible
#              to userspace and the kiosk cannot be operated at all
#   af_packet  udhcpc opens an AF_PACKET socket to send its DHCP discover
#   virtio_rng   seeds the entropy pool in a VM. RDP's NLA handshake is the
#                first thing here to want randomness, and on a machine with no
#                disk, no entropy-gathering daemon and a CPU whose RDRAND the
#                kernel does not trust, getrandom() blocks — the connection then
#                fails with a timeout against a server that is answering fine.
#   uhci_hcd,    ehci_pci (USB2.0/EHCI) does not handle low/full-speed devices
#   ohci_pci     itself — it hands them to a companion UHCI (most Intel
#                chipsets, e.g. the ICH10/C600-series boards under HP ProLiant
#                Gen7/Gen8) or OHCI controller. Without the companion driver a
#                USB keyboard or mouse plugged into such a machine enumerates
#                nowhere. QEMU testing never caught this because test-qemu.sh
#                drove input over PS/2.
#   alx ... 8139too  onboard NICs of mid-2010s desktops and thin clients (a Dell
#                Wyse 7010 among them); without the right one there is no ethN
#                at all and the scan has no subnet to look at.
#   sd_mod ... uas   disks. A SATA or USB disk shows up only after its
#                controller has probed its ports, too late for the coldplug
#                rounds below, and nothing loads drivers on hotplug; with these
#                loaded up front every disk binds whenever it appears — the one
#                being installed to, the data partition of an installed kiosk,
#                a USB stick plugged in later.
for m in evdev af_packet virtio_pci virtio_net \
         virtio_rng e1000 e1000e r8169 igb igc tg3 \
         alx atl1c atl1e atl1 atl2 b44 bnx2 jme sky2 skge forcedeth \
         8139cp 8139too \
         atkbd psmouse usbhid hid_generic \
         xhci_pci ehci_pci uhci_hcd ohci_pci \
         sd_mod sr_mod usb-storage uas; do
    modprobe "$m" 2>/dev/null
done

# Second, coldplug: every device the kernel has found announces the driver it
# wants as a modalias, and modprobe resolves that through modules.alias. This
# is what covers the long tail — any NIC, USB controller, HID device or chipset
# the list above does not name — on old hardware and new alike, the same way a
# full distribution's initramfs does it.
#
# Display adapters (PCI class 03, and virtio-gpu behind virtio_pci) are left
# to the display step below, which decides whether their driver is loaded at
# all. Three rounds, because loading a driver makes new devices appear behind
# it: a USB host controller brings up its hubs and devices, a HID transport its
# HID devices.
coldplug() {
    for f in /sys/bus/pci/devices/*/modalias /sys/bus/usb/devices/*/modalias \
             /sys/bus/hid/devices/*/modalias /sys/bus/serio/devices/*/modalias \
             /sys/bus/acpi/devices/*/modalias /sys/bus/platform/devices/*/modalias \
             /sys/bus/i2c/devices/*/modalias /sys/bus/virtio/devices/*/modalias \
             /sys/bus/hdaudio/devices/*/modalias /sys/bus/sdio/devices/*/modalias \
             /sys/bus/mmc/devices/*/modalias /sys/bus/scsi/devices/*/modalias; do
        [ -r "$f" ] || continue
        alias=$(cat "$f" 2>/dev/null)
        [ -n "$alias" ] || continue
        # platform:pcspkr is the board's beeper. Its sound driver, snd_pcsp,
        # registers as a sound card and would be picked to play the session's
        # audio — as clicks through a buzzer. The kiosk never beeps either.
        case "$alias" in
            pci:*bc03sc*|virtio:d00000010v*|platform:pcspkr) continue ;;
        esac
        modprobe -q "$alias" 2>/dev/null
    done
}
coldplug
sleep 1
coldplug
sleep 1
coldplug

# A card reader's slot is a disk that is always there: a card going in is a
# new medium, which the kernel notices only when it asks the drive. On a
# desktop udisks has it ask; here it asks every two seconds, so a card put in
# during a session shows up as a drive.
echo 2000 > /sys/module/block/parameters/events_dfl_poll_msecs 2>/dev/null

# Run the CPU flat out. A kiosk spends its life decoding the remote desktop;
# left to the BIOS's P-state a low-power thin-client CPU decodes at a fraction
# of its speed, which is the difference between smooth and stuttering.
modprobe acpi-cpufreq 2>/dev/null
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$g" ] && echo performance > "$g" 2>/dev/null
done
log "modules: $(wc -l < /proc/modules 2>/dev/null) loaded; cpufreq=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null)"
# The kiosk has no shell; these lines on the serial console are how a machine
# with a missing driver gets diagnosed.
log "loaded: $(cut -d' ' -f1 /proc/modules 2>/dev/null | tr '\n' ' ')"
log "sound cards: $(sed -n 's/^ *\([0-9]*\) \[\([^] ]*\) *\]: \(.*\)/\1=\2 (\3)/p' /proc/asound/cards 2>/dev/null | tr '\n' ' ')"
# A firmware framebuffer whose driver is a module has only now appeared.
splash_start

# ── Display ───────────────────────────────────────────────────────────────────
# GRUB leaves the screen in a firmware framebuffer — efifb on UEFI, vesafb on
# BIOS — which is /dev/fb0 from the first moment and works on anything. But it
# has one fixed mode and neither a vertical blank nor a cursor plane. The GPU's
# own (DRM) driver runs the display at its native mode, and the session engine
# flips whole frames on its vertical blank: that driver is loaded here, last,
# before anything draws. It takes the screen over from the firmware
# framebuffer and gives /dev/fb0 back at the display's resolution.
#
# The risk is a driver that takes the screen away and gives none back —
# firmware it needs and does not find, a GPU it hangs on. So the adapters are
# written into the boot environment first and cleared once there is a screen:
# a boot that dies in between, or is restarted from here for having no
# screen, makes GRUB leave them on the firmware framebuffer from then on. The
# boot menu's safe-graphics entry asks for that once. See bootenv.GraphicsTry.
load_display_drivers() {
    for d in /sys/bus/pci/devices/*; do
        case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
        # nouveau drives NVIDIA's Ada (RTX 40) and later only with NVIDIA's
        # GSP firmware, 76 MB that is not shipped. Loaded, it would take the
        # screen and fail; left alone, the firmware framebuffer stays.
        if [ "$(cat "$d/vendor")" = 0x10de ] && [ $(($(cat "$d/device"))) -ge $((0x2680)) ]; then
            log "display: ${d##*/} NVIDIA $(cat "$d/device") stays on the firmware framebuffer"
            continue
        fi
        modprobe -q "$(cat "$d/modalias")" 2>/dev/null
    done
    for f in /sys/bus/virtio/devices/*/modalias; do
        case "$(cat "$f" 2>/dev/null)" in
            virtio:d00000010v*) modprobe -q "$(cat "$f")" 2>/dev/null ;;
        esac
    done
}
GFX=$(/sbin/simpleclient -boot-graphics=mode 2>/dev/console)
if [ "$GFX" = safe ] && [ -e /dev/fb0 ]; then
    log "display: safe graphics, the firmware framebuffer"
else
    # Without a firmware framebuffer (a BIOS that would not set GRUB's mode)
    # the driver is all there is, safe graphics or not.
    MARKED=0
    if [ "$GFX" != safe ] && /sbin/simpleclient -boot-graphics=try 2>/dev/console; then
        MARKED=1
    fi
    splash_stop
    load_display_drivers
    i=0
    while [ ! -e /dev/fb0 ] && [ "$i" -lt 40 ]; do
        i=$((i + 1))
        sleep 0.25
    done
    if [ -e /dev/fb0 ]; then
        [ "$MARKED" = 1 ] && /sbin/simpleclient -boot-graphics=ok 2>/dev/console
    elif [ "$MARKED" = 1 ]; then
        log "ERROR: the GPU's driver left no screen ($(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')); restarting with safe graphics"
        sync
        reboot -f
    fi
fi
log "drm: $(for c in /sys/class/drm/card*-*; do [ -e "$c/status" ] && echo "${c##*/}=$(cat "$c/status")"; done | tr '\n' ' ')"
if [ ! -e /dev/fb0 ]; then
    log "ERROR: /dev/fb0 missing after module load"
    log "drm: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"
else
    # The console starts out blanked on some firmware; anything written to the
    # framebuffer then goes nowhere visible. Unblank before handing over.
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null
    log "fb0: $(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null) bpp=$(cat /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null) driver=$(cat /sys/class/graphics/fb0/name 2>/dev/null)"
    splash_start
fi

# ── Video decoders ────────────────────────────────────────────────────────────
# The GPUs' VA-API drivers, which decode the sessions' H.264 (engine/hwdec.c),
# are 70 MB unpacked, and come compressed with xz in 12. A machine has use for
# one maker's at most, and only with memory to spare for what the GPU decodes
# into, beside the session's own: with 1.4 GB or more, those for the GPUs it
# runs are unpacked here, and the rest go. In safe graphics no GPU runs, and
# the CPU decodes.
GPUS=" $(for r in /sys/class/drm/renderD*; do readlink "$r/device/driver" 2>/dev/null; done | sed 's|.*/||' | tr '\n' ' ')"
MEM=$(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo)
unpack() {
    for f in "$@"; do
        unxz -c "/usr/lib/dri/$f.xz" > "/usr/lib/dri/$f" 2>/dev/null || rm -f "/usr/lib/dri/$f"
    done
}
if [ "${MEM:-0}" -ge 1433600 ]; then
    case "$GPUS" in *" i915 "* | *" xe "*) unpack iHD_drv_video.so i965_drv_video.so ;; esac
    case "$GPUS" in *" amdgpu "* | *" radeon "*) unpack libgallium_drv_video.so ;; esac
fi
rm -f /usr/lib/dri/*.xz
for l in /usr/lib/dri/*; do [ -e "$l" ] || rm -f "$l"; done
log "video: GPU drivers [${GPUS# }], $((${MEM:-0} / 1024)) MB, VA-API drivers [$(ls /usr/lib/dri 2>/dev/null | tr '\n' ' ')]"

# ── Input ─────────────────────────────────────────────────────────────────────
# Input devices do not all appear the moment their module loads: psmouse spends
# about a second probing the PS/2 protocol, and USB devices take longer still to
# enumerate. Starting the kiosk immediately means auto-detect runs before the
# mouse exists and the session ends up keyboard-only. Wait for one, but never
# hold up the boot for more than a few seconds — a machine with no mouse is
# still perfectly usable with the arrow keys.
i=0
while [ "$i" -lt 20 ]; do
    if grep -qiE '^N: Name=.*(mouse|touchpad)' /proc/bus/input/devices 2>/dev/null; then
        break
    fi
    i=$((i + 1))
    sleep 0.25
done

log "input: $(ls /dev/input/event* 2>/dev/null | tr '\n' ' ')"

# The capability lines, not just the names. Which device is the keyboard is
# decided from these bitmaps, so when a machine comes up with a working mouse
# and a dead keyboard they are what says why — and they can only be read off the
# machine that failed.
#
# One grep, one line. Reading the file with a shell `while read` loop instead
# hung init here on the very first boot that tried it, before it ever reached
# the UI; a single pass by an external tool is what this file already did for
# the names, and it works.
log "input caps: $(grep -hE '^(N: |H: |B: (EV|KEY|REL|ABS)=)' /proc/bus/input/devices 2>/dev/null | tr '\n' '|')"
log "entropy: $(cat /proc/sys/kernel/random/entropy_avail 2>/dev/null) hwrng=$(cat /sys/class/misc/hw_random/rng_current 2>/dev/null)"
if [ -z "$(ls /dev/input/event* 2>/dev/null)" ]; then
    log "WARNING: no /dev/input/event* — the keyboard will not work"
fi

# ── Kernel command line options ───────────────────────────────────────────────
# lang=tr on the GRUB command line selects the startup UI language. F2 still
# toggles it at runtime.
# kbddev=/dev/input/eventN and mousedev=/dev/input/eventN pin the input nodes,
# bypassing autodetection, for the one machine where it still picks the wrong
# device — a GRUB command-line edit (press 'e'), no rebuild.
# bpp=24 asks for a 24-bit session instead of the default 16.
# rdpdebug logs the whole RDP handshake to the console, which grub.cfg points at
# the serial port. Diagnostic only — the RDP library prints the password in
# clear text at that level.
LANG_ARG=""
RDP_ARG=""
KBD_ARG=""
MOUSE_ARG=""
BPP_ARG=""
HOST_ARG=""
SLOT=""
DATA_UUID=""
for arg in $(cat /proc/cmdline 2>/dev/null); do
    case "$arg" in
        lang=*)   LANG_ARG="-lang=${arg#lang=}" ;;
        rdpdebug) RDP_ARG="-rdp-debug" ;;
        rdphost=*) HOST_ARG="-host=${arg#rdphost=}" ;;
        kbddev=*) KBD_ARG="-kbd=${arg#kbddev=}" ;;
        mousedev=*) MOUSE_ARG="-mouse=${arg#mousedev=}" ;;
        bpp=*) BPP_ARG="-bpp=${arg#bpp=}" ;;
        sc.slot=*) SLOT=${arg#sc.slot=} ;;
        sc.data=*) DATA_UUID=${arg#sc.data=} ;;
        sc.ip=*) NET_IP=${arg#sc.ip=} ;;
        sc.gw=*) NET_GW=${arg#sc.gw=} ;;
        sc.dns=*) NET_DNS=${arg#sc.dns=} ;;
        sc.iface=*) NET_IFACE=${arg#sc.iface=} ;;
    esac
done
log "kernel: $(uname -r)"

# ── Disk install ──────────────────────────────────────────────────────────────
# sc.slot= is set only by the GRUB of an installed disk. Its data partition
# holds settings and logs; the disk controller's driver has just been loaded
# and may still be finding the disk, so wait a little for it. sc.data= is the
# partition's UUID — another disk in the machine can have SimpleClient on it
# too, with the same labels — and an install without UUIDs goes by the label.
if [ -n "$SLOT" ]; then
    mkdir -p /data
    DATA_DEV=""
    DATA_KEY=LABEL=SC_DATA
    [ -n "$DATA_UUID" ] && DATA_KEY=UUID=$DATA_UUID
    i=0
    while [ "$i" -lt 40 ]; do
        DATA_DEV=$(findfs "$DATA_KEY" 2>/dev/null) && break
        i=$((i + 1))
        sleep 0.25
    done
    if [ -n "$DATA_DEV" ] && mount -t ext4 "$DATA_DEV" /data 2>/dev/null; then
        log "disk install: slot $SLOT, data on $DATA_DEV"
    else
        log "disk install: slot $SLOT, data partition not found"
    fi
fi

# ── Network ───────────────────────────────────────────────────────────────────
ip link set lo up 2>/dev/null

# Kernel is booted with net.ifnames=0 (see grub.cfg) so interfaces are ethN,
# but fall back to whatever non-loopback interfaces exist.
#
# A NIC does not exist the moment its driver is loaded: some (igb, bnx2 with
# its firmware, USB adapters) take a few seconds to register. Listing the
# interfaces straight away found none on those machines and left the kiosk
# with no network at all, so wait for one — up to ten seconds.
i=0
while [ "$i" -lt 40 ]; do
    IFACES=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$')
    [ -n "$IFACES" ] && break
    i=$((i + 1))
    sleep 0.25
done
log "interfaces: $(echo $IFACES)"

for i in $IFACES; do
    ip link set "$i" up 2>/dev/null
done

# The network settings: DHCP unless told otherwise. sc.ip= on the kernel
# command line comes first (sc.ip=192.168.1.50/24 sc.gw=192.168.1.1
# sc.dns=192.168.1.1,1.1.1.1, optionally sc.iface=eth1; sc.ip=dhcp forces
# DHCP), as the way to set a CD-booted kiosk; then what the network dialog
# (F8) saved — on the data partition of an installed kiosk, on the USB stick
# a live one runs from (live_dev). sc-net applies them.
#
# With DHCP, udhcpc stays running in the background on every interface (-b): a
# lease that is not there at boot — cable plugged in later, DHCP server slow
# to answer — is picked up whenever it arrives, and an existing one is renewed
# instead of silently expiring. The kiosk notices the new address on its own
# and scans it. The first attempt is waited for, so the usual case boots with
# its address already in place.
NETCONF=/run/sc-network
if [ -n "$NET_IP" ]; then
    if [ "$NET_IP" = dhcp ]; then
        echo mode=dhcp > "$NETCONF"
    else
        {
            echo mode=static
            echo "address=$NET_IP"
            echo "gateway=$NET_GW"
            echo "dns=$(echo "$NET_DNS" | tr ',' ' ')"
            echo "interface=$NET_IFACE"
        } > "$NETCONF"
    fi
elif [ -f /data/simpleclient/network ]; then
    cp /data/simpleclient/network "$NETCONF"
elif EFI_DEV=$(live_dev); then
    mkdir -p /run/sc-efi
    if mount -t vfat -o ro "$EFI_DEV" /run/sc-efi 2>/dev/null; then
        cp /run/sc-efi/simpleclient/network "$NETCONF" 2>/dev/null
        umount /run/sc-efi
    fi
fi
STATIC_IF=""
if [ "$(sed -n 's/^mode=//p' "$NETCONF" 2>/dev/null)" = static ]; then
    STATIC_IF=$(sed -n 's/^interface=//p' "$NETCONF")
    [ -n "$STATIC_IF" ] || STATIC_IF=$(echo $IFACES | cut -d' ' -f1)
fi

# The wireless network the kiosk keeps (F8, then its wireless row), kept where
# the network settings are; sc-net has wpa_supplicant join it.
WIFICONF=/run/sc-wifi.conf
if [ -f /data/simpleclient/wifi.conf ]; then
    cp /data/simpleclient/wifi.conf "$WIFICONF"
elif [ -z "$SLOT" ] && EFI_DEV=$(live_dev); then
    mkdir -p /run/sc-efi
    if mount -t vfat -o ro "$EFI_DEV" /run/sc-efi 2>/dev/null; then
        cp /run/sc-efi/simpleclient/wifi.conf "$WIFICONF" 2>/dev/null
        umount /run/sc-efi
    fi
fi
chmod 600 "$WIFICONF" 2>/dev/null

sc-net apply 2>/dev/console

# Joining a wireless network takes a few seconds — a scan, the handshake, then
# DHCP — which sc-net does not wait for. With one kept and no address from a
# cable, wait for it as for a lease, up to fifteen seconds: the kiosk would
# otherwise start on the link-local fallback below.
if grep -q '^network=' "$WIFICONF" 2>/dev/null; then
    i=0
    while [ "$i" -lt 60 ] && ! ip -4 -o addr show | grep -v ' lo ' | grep -q 'inet '; do
        i=$((i + 1))
        sleep 0.25
    done
    [ "$i" -lt 60 ] || log "wireless: no address after 15 s"
fi

GOT_IP=0
for i in $IFACES; do
    a=$(ip -4 -o addr show dev "$i" 2>/dev/null | grep -o 'inet [0-9./]*')
    if [ -n "$a" ] && [ "$i" = "$STATIC_IF" ]; then
        GOT_IP=1
        log "static on $i: $a"
    elif [ -n "$a" ]; then
        GOT_IP=1
        log "DHCP on $i: $a"
    else
        log "no lease yet on $i (carrier=$(cat /sys/class/net/$i/carrier 2>/dev/null))"
    fi
done

if [ "$GOT_IP" = "0" ]; then
    # No DHCP server: fall back to link-local so the scanner still has a subnet
    # to work with on a flat, unmanaged network.
    for i in $IFACES; do
        if ip addr add 169.254.100.100/16 dev "$i" 2>/dev/null; then
            log "no DHCP; using link-local on $i"
            break
        fi
    done
fi

# ── Startup server ────────────────────────────────────────────────────────────
# The server the kiosk goes to as it starts (F10 in the connection dialog),
# kept where the network settings are: the data partition of an installed
# kiosk, the USB stick a live one runs from (live_dev) — not that of
# a stick merely plugged into an installed one.
if [ -f /data/simpleclient/autoconnect ]; then
    cp /data/simpleclient/autoconnect /run/sc-autoconnect
elif [ -z "$SLOT" ] && EFI_DEV=$(live_dev); then
    mkdir -p /run/sc-efi
    if mount -t vfat -o ro "$EFI_DEV" /run/sc-efi 2>/dev/null; then
        cp /run/sc-efi/simpleclient/autoconnect /run/sc-autoconnect 2>/dev/null
        umount /run/sc-efi
    fi
fi
chmod 600 /run/sc-autoconnect 2>/dev/null

# ── Kiosk loop ────────────────────────────────────────────────────────────────
# Restart simpleclient if it exits, so a crash does not leave a blank screen.
# The splash stays on the screen until the kiosk's first one replaces it.
splash_stop
while true; do
    /sbin/simpleclient $LANG_ARG $RDP_ARG $HOST_ARG $KBD_ARG $MOUSE_ARG $BPP_ARG
    log "simpleclient exited ($?); restarting in 2s"
    sleep 2
done
